// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Perfil {
  solicitante
  gestor

  @@map("perfil")
}

enum Prioridade {
  baixa
  media
  alta

  @@map("prioridade")
}

enum Status {
  aberta
  analise
  aprovada
  rejeitada

  @@map("status")
}

model Usuario {
  id          String   @id @default(uuid()) @db.Uuid
  nome        String
  email       String   @unique
  senhaHash   String   @map("senha_hash")
  perfil      Perfil   @default(solicitante)
  ativo       Boolean  @default(true)
  dataCriacao DateTime @default(now()) @map("data_criacao")

  solicitacoes Solicitacao[]
  decisoes     HistoricoDecisao[]

  @@map("usuario")
}

model Area {
  id           Int           @id @default(autoincrement())
  descricao    String
  solicitacoes Solicitacao[]

  @@map("area")
}

model Solicitacao {
  id                String     @id @default(uuid()) @db.Uuid
  areaSolicitanteId Int        @map("area_solicitante_id")
  solicitanteId     String     @map("solicitante_id") @db.Uuid
  titulo            String
  descricao         String
  prioridade        Prioridade
  status            Status     @default(aberta)
  dataSolicitacao   DateTime   @default(now()) @map("data_solicitacao")
  dataAtualizacao   DateTime   @default(now()) @updatedAt @map("data_atualizacao")
  dataExclusao      DateTime?  @map("data_exclusao")

  area              Area               @relation(fields: [areaSolicitanteId], references: [id], onDelete: Restrict)
  solicitante       Usuario            @relation(fields: [solicitanteId], references: [id], onDelete: Restrict)
  historicosDecisao HistoricoDecisao[]

  @@index([status])
  @@index([prioridade])
  @@index([dataSolicitacao])
  @@index([areaSolicitanteId])
  @@index([solicitanteId])
  @@map("solicitacao")
}

model HistoricoDecisao {
  id            Int      @id @default(autoincrement())
  solicitacaoId String   @map("solicitacao_id") @db.Uuid
  responsavelId String   @map("responsavel_id") @db.Uuid
  status        Status
  comentario    String?
  dataDecisao   DateTime @default(now()) @map("data_decisao")

  solicitacao Solicitacao @relation(fields: [solicitacaoId], references: [id], onDelete: Cascade)
  responsavel Usuario     @relation(fields: [responsavelId], references: [id], onDelete: Restrict)

  @@index([solicitacaoId])
  @@index([responsavelId])
  @@map("historico_decisao")
}
